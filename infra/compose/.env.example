# Local development only. Never reuse these values outside a developer workstation.
POSTGRES_BOOTSTRAP_PASSWORD=local-bootstrap-only
MINIO_ROOT_USER=local-minio
MINIO_ROOT_PASSWORD=local-minio-password

# Local S3-compatible object storage for workspace assets.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_INTERNAL_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_BUCKET=platform-assets
OBJECT_STORAGE_ACCESS_KEY=local-minio
OBJECT_STORAGE_SECRET_KEY=local-minio-password
OBJECT_STORAGE_REGION=us-east-1

# Independent signed deletion-ledger archive (local development only).
DELETION_LEDGER_HMAC_KEY=local-ledger-signing-key-at-least-32-bytes
DELETION_LEDGER_S3_ENDPOINT=http://object-storage:9000
DELETION_LEDGER_S3_BUCKET=platform-deletion-ledger
DELETION_LEDGER_S3_PREFIX=v1/exports
DELETION_LEDGER_S3_ACCESS_KEY=local-minio
DELETION_LEDGER_S3_SECRET_KEY=local-minio-password
DELETION_LEDGER_S3_REGION=us-east-1
DELETION_LEDGER_S3_ALLOW_INSECURE_HTTP=true

# Local provider-execution consumer identity (separate from platform_worker).
PROVIDER_EXECUTION_DATABASE_URL=postgres://platform_provider_worker:local-provider-worker-only@postgres:5432/platform
