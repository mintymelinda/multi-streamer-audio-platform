# Non-production staging only. Copy to .env.staging, replace every value,
# and restrict the copied file to the deployment operator (chmod 600).
POSTGRES_BOOTSTRAP_PASSWORD=replace-with-unique-bootstrap-password
PLATFORM_MIGRATOR_PASSWORD=replace-with-unique-migrator-password
PLATFORM_RUNTIME_PASSWORD=replace-with-unique-runtime-password
PLATFORM_WORKER_PASSWORD=replace-with-unique-worker-password
PLATFORM_PROVIDER_WORKER_PASSWORD=replace-with-unique-provider-worker-password

MINIO_ROOT_USER=replace-minio-user
MINIO_ROOT_PASSWORD=replace-with-unique-minio-password

DASHBOARD_DOMAIN=dashboard.staging.example.net
OVERLAY_DOMAIN=overlay.staging.example.net
API_DOMAIN=api.staging.example.net
ASSET_DOMAIN=assets.staging.example.net
ACME_EMAIL=operator@example.net
PLATFORM_NETWORK_NAME=platform-staging
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0

# Exact callback URLs must also be registered in the Twitch developer console.
TWITCH_CLIENT_ID=replace-with-twitch-client-id
TWITCH_REDIRECT_URI=https://dashboard.staging.example.net/auth/twitch/callback
TWITCH_INTEGRATION_REDIRECT_URI=https://dashboard.staging.example.net/auth/twitch/integration/callback
LYRION_ALLOWED_HOSTS=
INVIDIOUS_INSTANCE_URL=https://your-trusted-invidious-instance.example

# Paths are relative to infra/compose/docker-compose.staging.yml.
API_DATABASE_URL_SECRET_FILE=./secrets/api-database-url
WORKER_DATABASE_URL_SECRET_FILE=./secrets/worker-database-url
PROVIDER_EXECUTION_DATABASE_URL_SECRET_FILE=./secrets/provider-execution-database-url
REDIS_URL_SECRET_FILE=./secrets/redis-url
TWITCH_CLIENT_SECRET_FILE_SOURCE=./secrets/twitch-client-secret
INTEGRATION_KEK_RING_FILE_SOURCE=./secrets/integration-kek-ring.json
PROVIDER_EXECUTION_HANDOFF_SECRET_FILE_SOURCE=./secrets/provider-execution-handoff-secret
