{
	admin off
	email {$ACME_EMAIL}
}

{$DASHBOARD_DOMAIN} {
	encode zstd gzip
	@api_callbacks path /auth/twitch/callback /auth/twitch/integration/callback /webhooks/twitch/eventsub
	handle @api_callbacks {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy dashboard:3000
	}
}

{$OVERLAY_DOMAIN} {
	encode zstd gzip
	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}
	reverse_proxy overlay:3001
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:3000
}

{$ASSET_DOMAIN} {
	encode zstd gzip
	reverse_proxy object-storage:9000
}
